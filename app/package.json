{
  "name": "bt-experience-intelligence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "dev:online": "BT_API=${BT_API:-https://bt-experience-intelligence.vercel.app} vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/server.ts",
    "test": "node --test tests/*.test.ts",
    "test:lab": "node ../scripts/verify-lab.mjs",
    "build:sway": "node ../scripts/build-context-sway.ts",
    "build:memory": "node ../scripts/build-memory-map.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@vercel/functions": "^3.9.9",
    "border-beam": "^1.4.1",
    "d3-contour": "^4.0.2",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "ml-matrix": "^6.15.0",
    "postgres": "^3.4.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "umap-js": "^1.4.0",
    "voice-glow": "^0.2.1"
  },
  "devDependencies": {
    "@types/d3-contour": "^3.0.6",
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
